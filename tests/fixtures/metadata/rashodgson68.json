    "reviews": [
        {
            "reviewtitle": "bibliographical info",
            "reviewbody": "This is a historically important manuscript and the only surviving copy of this work\n\nLink to the 1876 catalogue, published in the JRAS (free download):\nhttps://www.jstor.org/stable/25207721 \n\nThis is the commentary titled Gu\u1e47abhara\u1e47\u012b by Ravi\u015br\u012bj\u00f1\u0101na on the work called the \u1e62a\u1e0da\u1e45gayoga.   See NCC v.36, p. 256\n\nEdn. Gunter Gronbold on the basis of this MS,  and revised with the help of Tibetan trans.; Munchen, 1969. (Worldcat Permalink: http://www.worldcat.org/oclc/68169120)  \n\nAlso edited and translated in 2000 by Francesco Sferr\n(Worldcat Permalink: http://www.worldcat.org/oclc/717433012)\nDownload: https://www.academia.edu/5713085/",
            "stars": "0",
